// ============================================================
// 2025 年度飞行报告：全屏章节式回顾
// 仅在报告页生效；不复用第三方产品的视觉资产或品牌语言。
// ============================================================
.layout:has(> #page.travel-page:has(#travel-report))
  width 100%
  max-width none
  margin 0
  padding 0

#page.travel-page:has(#travel-report)
  width 100%
  min-height 100dvh
  margin 0
  padding 0 !important
  border-radius 0
  background #050b1c !important

body:has(#travel-report)
  overflow hidden
  background #050b1c

  #web_bg,
  #page-header,
  #footer,
  .aside-content
    display none !important

  #content-inner
    width 100%
    max-width none !important
    margin 0 !important
    padding 0 !important

#travel-report
  --ar-bg #050b1c
  --ar-ink #f7faff
  --ar-muted rgba(225, 235, 255, .72)
  --ar-cyan #6cecff
  --ar-mint #66f0be
  --ar-violet #9b87ff
  color var(--ar-ink)
  background var(--ar-bg)
  font-family -apple-system, BlinkMacSystemFont, "SF Pro Display", "PingFang SC", "Microsoft YaHei", sans-serif
  -webkit-text-size-adjust 100%

  *, *::before, *::after
    box-sizing border-box

  .annual-report-nav
    position fixed
    z-index 10
    top clamp(1rem, 3vw, 2.25rem)
    left 50%
    width calc(100% - 2rem)
    max-width 1120px
    display flex
    align-items center
    justify-content space-between
    transform translateX(-50%)
    pointer-events none

    a, button
      pointer-events auto

  .annual-report-back
    border 1px solid rgba(230, 240, 255, .38)
    border-radius 999px
    padding .48rem .82rem
    color #fff
    background rgba(5, 11, 28, .32)
    backdrop-filter blur(12px)
    -webkit-backdrop-filter blur(12px)
    font-size .78rem
    line-height 1
    text-decoration none

  .annual-report-progress
    position absolute
    left 50%
    bottom -10px
    width 30vw
    max-width 230px
    height 2px
    overflow hidden
    border-radius 999px
    background rgba(255, 255, 255, .22)
    transform translateX(-50%)

    span
      display block
      width 12.5%
      height 100%
      border-radius inherit
      background linear-gradient(90deg, var(--ar-cyan), var(--ar-mint))
      box-shadow 0 0 12px var(--ar-cyan)
      transition width .35s ease

  .annual-report-deck
    height 100dvh
    overflow-y auto
    overflow-x hidden
    scroll-snap-type y mandatory
    scroll-behavior smooth
    scrollbar-width none
    outline none

    &::-webkit-scrollbar
      display none

  .annual-report-slide
    position relative
    display grid
    min-height 100dvh
    overflow hidden
    scroll-snap-align start
    scroll-snap-stop always
    place-items center
    isolation isolate
    background radial-gradient(circle at 72% 18%, rgba(83, 92, 224, .25), transparent 32%), linear-gradient(145deg, #060b24, #07142a 58%, #071730)

    &::before,
    &::after
      position absolute
      z-index -1
      content ""
      pointer-events none

    &::before
      width 48vmax
      height 48vmax
      border-radius 50%
      background radial-gradient(circle, rgba(98, 228, 255, .22), rgba(83, 121, 255, .05) 40%, transparent 68%)
      filter blur(8px)
      top -26vmax
      right -17vmax

    &::after
      inset 0
      background-image radial-gradient(rgba(255, 255, 255, .85) 1px, transparent 1.2px)
      background-size 36px 36px
      opacity .11

  .annual-slide-inner
    width calc(100% - 3rem)
    max-width 1040px
    margin auto
    padding 5.25rem 0 2.5rem

  .annual-kicker,
  .annual-eyebrow
    margin 0 0 .8rem
    color var(--ar-cyan)
    font-size clamp(.78rem, 1.3vw, .95rem)
    font-weight 750
    letter-spacing .16em
    text-transform uppercase

  h1, h2, h3, p
    margin-top 0

  h1, h2
    max-width 900px
    margin-bottom 1rem
    color #fff
    font-weight 800
    letter-spacing -.055em
    line-height 1.08

  h1
    font-size clamp(3rem, 8vw, 6.8rem)

  h2
    font-size clamp(2.1rem, 5.1vw, 4.5rem)

  .annual-lede,
  .annual-caption,
  .annual-quote,
  .annual-final-copy
    max-width 650px
    color var(--ar-muted)
    font-size clamp(1rem, 1.7vw, 1.28rem)
    line-height 1.8

  .annual-quote
    margin-top 2rem
    color #eff5ff
    font-size clamp(1.1rem, 2vw, 1.5rem)

  .annual-cover
    background linear-gradient(145deg, #06112d, #162b77 54%, #070c24)

  .annual-aurora,
  .annual-final-glow
    position absolute
    z-index -1
    width 82vmin
    max-width 1080px
    height 82vmin
    max-height 880px
    border-radius 50%
    background conic-gradient(from 120deg, rgba(109, 245, 200, .5), rgba(101, 198, 255, .14), rgba(166, 130, 255, .58), rgba(109, 245, 200, .5))
    filter blur(60px)
    opacity .72

  .annual-cover-inner
    text-align center

    .annual-lede
      margin-right auto
      margin-left auto

  .annual-cover-stats
    display flex
    justify-content center
    gap clamp(.8rem, 4vw, 3.2rem)
    margin 2.3rem 0

    span
      display grid
      gap .2rem
      color var(--ar-muted)
      font-size .82rem

    strong
      color #fff
      font-size clamp(1.45rem, 3vw, 2.35rem)
      font-variant-numeric tabular-nums

  .annual-next,
  .annual-return
    display inline-flex
    align-items center
    justify-content center
    min-height 44px
    padding .7rem 1.1rem
    border 1px solid rgba(108, 236, 255, .7)
    border-radius 999px
    color #03111f
    background linear-gradient(110deg, var(--ar-cyan), var(--ar-mint))
    box-shadow 0 0 28px rgba(108, 236, 255, .3)
    font-weight 800
    text-decoration none
    cursor pointer

  .annual-time
    background radial-gradient(circle at 80% 50%, rgba(91, 241, 207, .2), transparent 30%), linear-gradient(155deg, #07142d, #0c253c)

  .annual-split-stats
    display grid
    grid-template-columns repeat(3, 1fr)
    gap 1rem
    margin-top 2.2rem

    article
      min-height 175px
      padding 1.25rem
      border 1px solid rgba(190, 224, 255, .18)
      border-radius 22px
      background linear-gradient(145deg, rgba(255, 255, 255, .11), rgba(255, 255, 255, .03))
      box-shadow inset 0 1px rgba(255, 255, 255, .1), 0 20px 48px rgba(0, 0, 0, .13)

      span, small
        display block
        color var(--ar-muted)

      strong
        display block
        margin .55rem 0
        color #fff
        font-size clamp(1.6rem, 3.4vw, 2.7rem)
        line-height 1.1

  .annual-calendar
    background radial-gradient(circle at 50% 12%, rgba(100, 205, 255, .31), transparent 27%), linear-gradient(160deg, #061a42, #0a3656)

  .annual-heatmap
    display grid
    grid-template-columns repeat(12, minmax(0, 1fr))
    gap clamp(.25rem, 1vw, .65rem)
    margin-top 1.3rem
    padding 1.1rem
    border 1px solid rgba(164, 224, 255, .2)
    border-radius 24px
    background rgba(1, 15, 40, .36)
    backdrop-filter blur(9px)

  .annual-heat-month
    min-width 0

    > strong
      display block
      margin-bottom .35rem
      color #c8dcf5
      font-size .72rem
      text-align center

  .annual-heat-days
    display grid
    grid-template-columns repeat(2, minmax(0, 1fr))
    gap 3px

    span
      display block
      aspect-ratio 1
      border-radius 2px
      background rgba(163, 208, 255, .17)

    .heat-l1
      background #3d95c1

    .heat-l2
      background #5ee8d6
      box-shadow 0 0 8px rgba(94, 232, 214, .48)

    .heat-l3
      background #83e23d
      box-shadow 0 0 11px rgba(131, 226, 61, .6)

  .annual-calendar-note
    display flex
    align-items baseline
    gap .55rem
    margin-top 1rem
    color var(--ar-muted)

    strong
      color #fff
      font-size 1.15rem

    span + strong
      margin-left 1.4rem

  .annual-route
    background radial-gradient(circle at 46% 50%, rgba(44, 210, 255, .34), transparent 34%), linear-gradient(155deg, #051431, #0b2359)

  .annual-map-panel
    margin-top 1.1rem
    padding .7rem
    overflow hidden
    border 1px solid rgba(106, 227, 255, .34)
    border-radius 26px
    background rgba(3, 18, 55, .55)
    box-shadow 0 0 60px rgba(52, 169, 255, .12), inset 0 0 30px rgba(83, 130, 255, .12)

  .annual-map-svg
    display block
    width 100%
    height auto
    min-height 220px

  .annual-map-land .travel-land-path
    fill #17376d
    stroke #4d78af
    stroke-width .7

  .annual-map-routes path
    fill none
    stroke #67f2dc
    stroke-width 2.2
    filter drop-shadow(0 0 5px rgba(103, 242, 220, .9))

  .annual-map-nodes circle
    fill #e7ffff
    stroke #63f0dc
    stroke-width 3
    filter drop-shadow(0 0 5px #63f0dc)

  .annual-route-summary
    display flex
    justify-content center
    gap clamp(1.1rem, 6vw, 5rem)
    margin-top 1.1rem

    article
      display grid
      gap .15rem
      text-align center

      strong
        color var(--ar-cyan)
        font-size clamp(1.4rem, 3vw, 2.2rem)

      span
        color var(--ar-muted)
        font-size .8rem

  .annual-cities
    background radial-gradient(circle at 70% 38%, rgba(155, 135, 255, .27), transparent 32%), linear-gradient(145deg, #101047, #071c4c)

  .annual-city-list
    display grid
    grid-template-columns repeat(2, minmax(0, 1fr))
    gap .65rem 2.3rem
    max-width 780px
    padding 0
    margin 1.5rem 0 0
    list-style none

    li
      display grid
      grid-template-columns 2.5rem 1fr auto
      align-items baseline
      gap .5rem
      padding .65rem 0
      border-bottom 1px solid rgba(207, 226, 255, .2)

    strong
      font-size clamp(1.25rem, 2.6vw, 2rem)

    small, .annual-city-rank
      color var(--ar-muted)

    .annual-city-rank
      color var(--ar-cyan)
      font-size .8rem
      font-weight 800

  .annual-pattern
    background radial-gradient(circle at 28% 76%, rgba(108, 236, 255, .27), transparent 31%), linear-gradient(155deg, #08132f, #231348)

  .annual-pattern-grid,
  .annual-highlights-grid
    display grid
    grid-template-columns repeat(2, minmax(0, 1fr))
    gap 1rem
    margin-top 1.5rem

    article
      min-height 150px
      padding 1.2rem
      border 1px solid rgba(198, 214, 255, .2)
      border-radius 20px
      background rgba(5, 16, 44, .43)

      > span, small
        display block
        color var(--ar-muted)

      strong
        display block
        margin .52rem 0
        color #fff
        font-size clamp(1.25rem, 2.7vw, 2rem)
        word-break break-word

  .annual-disclaimer
    margin-top 1rem
    color rgba(222, 232, 255, .55)
    font-size .73rem

  .annual-highlights
    background radial-gradient(circle at 70% 24%, rgba(255, 183, 85, .28), transparent 30%), linear-gradient(150deg, #1e1027, #422416 62%, #0c142c)

  .annual-highlights-grid article
    min-height 165px
    background linear-gradient(140deg, rgba(255, 218, 133, .18), rgba(255, 255, 255, .05))

    > span
      color #ffd98d
      font-weight 800

    h3
      margin .45rem 0
      font-size 1.35rem

    p
      margin 0
      color var(--ar-muted)
      line-height 1.7

  .annual-final
    background radial-gradient(circle at 50% 47%, rgba(255, 207, 109, .35), transparent 22%), linear-gradient(165deg, #080a21, #2b1021 52%, #090717)

  .annual-final-glow
    background conic-gradient(from 10deg, rgba(255, 206, 109, .5), rgba(255, 112, 102, .16), rgba(123, 121, 255, .47), rgba(255, 206, 109, .5))

  .annual-final .annual-slide-inner
    max-width 850px
    text-align center

  .annual-final-copy
    margin-right auto
    margin-left auto

  .annual-final-numbers
    display flex
    justify-content center
    gap clamp(1rem, 6vw, 4rem)
    margin 2rem 0

    span
      display grid
      gap .25rem
      color var(--ar-muted)
      font-size .85rem

    strong
      color #fff
      font-size clamp(1.45rem, 3vw, 2.3rem)

  .annual-report-empty
    min-height 100dvh
    display grid
    place-items center
    color #dce9ff

  @media (prefers-reduced-motion: no-preference)
    .annual-aurora,
    .annual-final-glow
      animation annualGlow 9s ease-in-out infinite alternate

  @keyframes annualGlow
    from
      transform scale(.9) rotate(-8deg)
      opacity .48

    to
      transform scale(1.08) rotate(9deg)
      opacity .8

  +maxWidth768()
    .annual-report-nav
      top .85rem
      width calc(100% - 1.25rem)

    .annual-report-progress
      width 35vw

    .annual-report-back
      padding .44rem .65rem
      font-size .7rem

    .annual-slide-inner
      width calc(100% - 2rem)
      padding-top 5rem
      padding-bottom 2rem

    .annual-cover-stats
      gap .8rem

    .annual-split-stats
      grid-template-columns 1fr
      gap .65rem
      margin-top 1.1rem

      article
        min-height 0
        padding .85rem 1rem

    .annual-heatmap
      grid-template-columns repeat(6, minmax(0, 1fr))
      gap .45rem
      padding .7rem

    .annual-heat-days
      gap 2px

    .annual-calendar-note
      flex-wrap wrap
      justify-content center
      text-align center

      span + strong
        margin-left .65rem

    .annual-map-panel
      padding .35rem
      border-radius 18px

    .annual-map-svg
      min-height 180px

    .annual-city-list
      grid-template-columns 1fr
      gap .1rem
      margin-top .8rem

    .annual-pattern-grid,
    .annual-highlights-grid
      gap .65rem
      margin-top 1rem

      article
        min-height 132px
        padding .85rem

    .annual-final-numbers
      gap 1.2rem

@media (prefers-reduced-motion: reduce)
  #travel-report .annual-report-deck
    scroll-behavior auto
