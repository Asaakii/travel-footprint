// ============================================================
// 行程统计页（travel）高保真深色科技风
// 外壳覆盖: #page.travel-page（仅 travel 页，不影响其他页面）
// 组件样式: 严格限定在 #travel 内
// 调色板: page #06111f / map #04101c/#06243a / card #151f2e / card-alt #0c1726
//         border #26384d / text #f3f8ff / muted #8fa2b7
//         cyan #57f1ed / green #51e1a5 / blue #5d8dff / violet #9a7cff
// ============================================================

// 桌面内容宽度约 1280（.layout 自身 padding 1.25rem/1.5rem）
.layout:has(> #page.travel-page)
  max-width 1330px

#page.travel-page
  background #06111f !important
  border none !important
  box-shadow none !important
  border-radius 20px
  padding 1.6rem 1.8rem !important
  font-family -apple-system, BlinkMacSystemFont, "SF Pro Display", "PingFang SC", "Helvetica Neue", "Microsoft YaHei", sans-serif
  color #f3f8ff
  // 防止窄视口下浏览器字体自动放大破坏布局
  -webkit-text-size-adjust 100%
  text-size-adjust 100%

  +maxWidth768()
    border-radius 0
    padding 1rem .8rem !important

// ============================================================
// travel 页沉浸式深色全局外壳（仅此页生效；:has 动态响应 PJAX 进出）
// 覆盖站点浅色模式下的白色页头/导航/页脚/两侧留白
// ============================================================
body:has(#page.travel-page)
  background #06111f

  #web_bg
    background #06111f !important

  // 顶部导航：半透明深蓝 + 毛玻璃
  #page-header #nav
    background rgba(6, 17, 31, .72)
    backdrop-filter blur(10px)
    -webkit-backdrop-filter blur(10px)
    border-bottom 1px solid rgba(38, 56, 77, .8)

  #page-header #nav #blog_name a,
  #page-header #nav .mask-name-container a,
  #page-header #nav #menus a,
  #page-header #nav #nav-right .nav-button a,
  #page-header #nav #nav-right .nav-button i,
  #page-header #nav #toggle-menu,
  #page-header #nav #page-name
    color #dbe7f3 !important
    text-shadow none !important

  #page-header.not-top-img #nav #menus .menus_item:hover > a,
  #page-header.not-top-img #travellings_button::after
    background rgba(87, 241, 237, .14)

  #page-header.not-top-img #nav #blog_name .back-home-button:hover,
  #page-header.not-top-img #nav #blog_name #site-name:hover
    color #f3f8ff
    background rgba(87, 241, 237, .14)
    box-shadow none

  #page-header.nav-fixed #nav
    background rgba(6, 17, 31, .88)
    outline 1px solid #26384d

  // 页脚融入深色
  #footer
    background transparent !important
    color #8fa2b7

    a
      color #dbe7f3

  // footerBar 位于页脚外层，需单独覆盖其浅色主题背景
  #footer-bar
    margin-top 0
    background #081827 !important
    border-top 1px solid #26384d
    color #aabdd0 !important

    .footer-bar-link
      color #dbe7f3 !important

      &:hover
        color #57f1ed !important

#travel
  // ---- 局部设计变量 ----
  --tv-card #151f2e
  --tv-card-alt #0c1726
  --tv-border #26384d
  --tv-text #f3f8ff
  --tv-muted #8fa2b7
  --tv-cyan #57f1ed
  --tv-green #51e1a5
  --tv-blue #5d8dff
  --tv-violet #9a7cff

  color var(--tv-text)

  .travel-num
    font-weight 800
    font-variant-numeric tabular-nums
    letter-spacing .01em

  .travel-unit
    font-size .78rem
    font-weight 400
    color var(--tv-muted)
    margin-left .25rem

  .travel-ic
    width 20px
    height 20px
    display block

  // ---- 通用卡片 ----
  .travel-card
    background var(--tv-card)
    border-radius 20px
    padding 1.2rem 1.4rem
    margin-bottom 1rem
    border 1px solid var(--tv-border)
    box-shadow inset 0 1px 0 rgba(243, 248, 255, .04), 0 10px 28px -14px rgba(0, 0, 0, .55)

  .travel-section-head
    display flex
    flex-wrap wrap
    align-items center
    justify-content space-between
    gap .5rem
    margin-bottom .9rem

  .travel-section-title
    display inline-flex
    align-items center
    gap .45rem
    font-size 1.02rem
    font-weight 700
    color var(--tv-text)

    .travel-ic
      color var(--tv-cyan)

  .travel-period-label
    font-size .78rem
    color var(--tv-cyan)
    background rgba(87, 241, 237, .1)
    border 1px solid rgba(87, 241, 237, .22)
    border-radius 999px
    padding .12rem .6rem

  .travel-sub-title
    font-size .85rem
    font-weight 700
    color var(--tv-muted)
    margin 1rem 0 .5rem

  // ---- 标题栏（原创翼形品牌位） ----
  .travel-top
    padding .4rem .2rem 1rem

  .travel-brand
    display flex
    align-items center
    gap .8rem

  .travel-brand-mark
    width 44px
    height 44px
    flex none
    filter drop-shadow(0 0 10px rgba(87, 241, 237, .35))

  .travel-brand-title
    font-size 1.5rem
    font-weight 800
    letter-spacing .06em
    background linear-gradient(90deg, #f3f8ff, #9fd9e8)
    -webkit-background-clip text
    background-clip text
    -webkit-text-fill-color transparent

  .travel-brand-sub
    font-size .82rem
    color var(--tv-muted)
    margin-top .1rem

  // ---- 年份胶囊 ----
  .travel-year-filter
    display flex
    flex-wrap wrap
    gap .5rem
    margin-bottom 1rem

  .travel-year-chip
    appearance none
    font inherit
    font-size .85rem
    font-weight 600
    padding .32rem 1.05rem
    border-radius 999px
    color var(--tv-muted)
    background var(--tv-card-alt)
    border 1px solid var(--tv-border)
    cursor pointer
    user-select none
    transition background .2s, color .2s, box-shadow .2s

    &:hover
      color var(--tv-text)
      border-color rgba(87, 241, 237, .4)

    &:focus-visible
      outline 2px solid var(--tv-cyan)
      outline-offset 2px

    &.active
      color #04101c
      background linear-gradient(90deg, var(--tv-cyan), var(--tv-blue))
      border-color transparent
      box-shadow 0 0 14px rgba(87, 241, 237, .35)

  // ---- 航线图 ----
  .travel-map
    background linear-gradient(180deg, #06243a 0%, #04101c 100%)
    overflow hidden

  .travel-map-wrap
    border-radius 14px
    overflow hidden
    border 1px solid rgba(87, 241, 237, .14)
    user-select none
    -webkit-user-select none

  .travel-map-svg
    width 100%
    height auto
    display block
    user-select none
    -webkit-user-select none
    -webkit-touch-callout none
    -webkit-user-drag none

    text
      pointer-events none
      user-select none
      -webkit-user-select none

    +maxWidth768()
      height 250px

  .travel-map-ocean
    fill #04101c

  .travel-map-grid line
    stroke rgba(87, 241, 237, .05)
    stroke-width 1
    vector-effect non-scaling-stroke

  .travel-land-path,
  .travel-land-detail-path
    fill #0b3148
    stroke rgba(87, 241, 237, .14)
    stroke-width .55
    vector-effect non-scaling-stroke

  .travel-borders-path,
  .travel-borders-detail-path
    fill none
    stroke rgba(170, 205, 235, .55)
    stroke-width 1
    vector-effect non-scaling-stroke

  .travel-provinces-path
    fill none
    stroke rgba(87, 241, 237, .42)
    stroke-width .7
    vector-effect non-scaling-stroke

  .travel-map-contlabels text
    fill rgba(143, 162, 183, .35)
    font-size calc(17px * var(--zl, 1))
    font-weight 700
    letter-spacing .3em
    text-anchor middle

  // 实线航迹 + 中点箭头，青/蓝分层；描边不随缩放变粗
  .travel-map-routes path
    fill none
    stroke-linecap round
    stroke-linejoin round
    stroke-dasharray none
    vector-effect non-scaling-stroke

    &:hover,
    &:focus-visible
      opacity 1 !important
      outline none
      filter drop-shadow(0 0 3px currentColor)

  .travel-map-routes .lc0, .travel-map-arrows .lc0,
  .travel-map-routes .lc1, .travel-map-arrows .lc1
    stroke var(--tv-cyan) !important
  .travel-map-routes .lc2, .travel-map-arrows .lc2
    stroke var(--tv-violet) !important

  .travel-map-arrows path
    stroke none !important
    &.lc0,
    &.lc1
      fill var(--tv-cyan) !important
    &.lc2
      fill var(--tv-violet) !important

  .travel-map-svg
    cursor grab
    touch-action none

    &.is-dragging
      cursor grabbing

  // 缩放层级：far=国界+大洲名；mid=+国家名；near=+首都/中国省界/省名（国家名淡出）
  .travel-map-layer-countries text
    fill rgba(219, 231, 243, .5)
    font-size calc(9px * var(--zl, 1))
    text-anchor middle

  .travel-map-layer-capitals
    circle
      fill rgba(219, 231, 243, .7)
      r calc(1.1px * var(--zl, 1))
    text
      fill rgba(219, 231, 243, .6)
      font-size calc(7.5px * var(--zl, 1))

  .travel-map-layer-provinces text
    fill rgba(87, 241, 237, .75)
    font-size calc(9px * var(--zl, 1))
    text-anchor middle

  .travel-map-svg[data-zoom="far"]
    .travel-map-layer-countries,
    .travel-map-layer-capitals,
    .travel-map-layer-provinces,
    .travel-map-provinces,
    .travel-map-land-detail,
    .travel-map-borders-detail
      display none

  .travel-map-svg[data-zoom="mid"]
    .travel-map-layer-capitals,
    .travel-map-layer-provinces,
    .travel-map-provinces,
    .travel-map-land-detail,
    .travel-map-borders-detail
      display none

  .travel-map-svg[data-zoom="near"]
    .travel-map-contlabels
      display none
    .travel-map-layer-countries
      opacity .35
    .travel-map-land,
    .travel-map-borders
      display none
    .travel-land-detail-path
      stroke rgba(87, 241, 237, .18)
      stroke-width .45

  // 兼容 PJAX/浏览器缓存中的旧版光晕层标记（已废弃，防止默认黑色填充）
  .travel-map-glowroutes
    display none

  .travel-map-routes .lc0,
  .travel-map-routes .lc1
    color var(--tv-cyan)
  .travel-map-routes .lc2
    color var(--tv-violet)

  .travel-map-node
    fill var(--tv-cyan)
    stroke #04101c
    stroke-width 1
    r calc(var(--r, 3px) * var(--zl, 1))
    vector-effect non-scaling-stroke

  .travel-map-halo
    fill rgba(87, 241, 237, .18)
    r calc(var(--r, 6px) * var(--zl, 1))

  .travel-map-aplabel
    fill var(--tv-text)
    font-size calc(12px * var(--zl, 1))
    font-weight 600
    paint-order stroke
    stroke #04101c
    stroke-width calc(3px * var(--zl, 1))

  .travel-map-legend
    display flex
    flex-wrap wrap
    gap .4rem 1.2rem
    margin-top .6rem
    font-size .75rem
    color var(--tv-muted)

  .travel-map-legend-item
    display inline-flex
    align-items center
    gap .35rem

  .travel-map-legend-line
    display inline-block
    width 18px
    height 3px
    border-radius 2px
    background var(--tv-cyan)

  .travel-map-legend-dot
    display inline-block
    width 8px
    height 8px
    border-radius 50%
    background var(--tv-cyan)

  // ---- 总览仪表盘 ----
  .travel-dash
    display flex
    align-items center
    gap 2rem
    background linear-gradient(135deg, rgba(21, 31, 46, .92), rgba(12, 23, 38, .96))

    +maxWidth768()
      flex-direction column
      gap 1rem
      padding 1.1rem

  .travel-dash-gauge
    position relative
    flex none
    width 190px
    text-align center

    svg
      width 180px
      height 180px
      display block

  .travel-gauge-track
    fill none
    stroke var(--tv-card-alt)
    stroke-width 12

  .travel-gauge-val
    fill none
    stroke url(#travelGaugeGrad)
    stroke-width 12
    stroke-linecap round
    transition stroke-dashoffset .5s ease

  .travel-gauge-center
    position absolute
    top 0
    left 0
    width 100%
    height 180px
    display flex
    flex-direction column
    align-items center
    justify-content center

  .travel-gauge-num
    font-size 1.9rem
    font-weight 800
    font-variant-numeric tabular-nums
    line-height 1.1

  .travel-gauge-unit
    font-size .8rem
    color var(--tv-muted)

  .travel-gauge-caption
    font-size .74rem
    color var(--tv-green)
    margin-top .2rem

  .travel-dash-stats
    flex 1
    display flex
    flex-direction column
    gap .4rem
    min-width 0
    width 100%

  .travel-dash-stat
    display flex
    align-items center
    gap .8rem
    padding .55rem .3rem

    & + .travel-dash-stat
      border-top 1px solid rgba(38, 56, 77, .6)

  .travel-dash-ic
    flex none
    width 38px
    height 38px
    border-radius 12px
    display flex
    align-items center
    justify-content center

  .travel-dash-stat-text
    display flex
    align-items baseline
    justify-content space-between
    flex 1
    gap .6rem

  .travel-dash-label
    font-size .85rem
    color var(--tv-muted)

  .travel-dash-value .travel-num
    font-size 1.5rem

  .travel-dash-value .travel-num-sm
    font-size 1.1rem
    margin-left .35rem

  // 图标底色（青/绿/蓝/紫）
  .ic-cyan
    background rgba(87, 241, 237, .12)
    color var(--tv-cyan)
  .ic-green
    background rgba(81, 225, 165, .12)
    color var(--tv-green)
  .ic-blue
    background rgba(93, 141, 255, .12)
    color var(--tv-blue)
  .ic-violet
    background rgba(154, 124, 255, .12)
    color var(--tv-violet)

  // ---- 五项足迹（可点击卡片） ----
  a.travel-fp-card
    text-decoration none
    color inherit
    cursor pointer

  .travel-footprint
    display grid
    grid-template-columns repeat(5, minmax(0, 1fr))
    gap .8rem
    margin-bottom 1rem

    // pangu.js 会在「数字结尾」和「中文开头」的卡片之间插入 <pangu>，挤占网格
    > pangu
      display none !important

    +maxWidth900()
      grid-template-columns repeat(3, minmax(0, 1fr))

    +maxWidth768()
      grid-template-columns repeat(2, minmax(0, 1fr))
      gap .6rem

  .travel-fp-card
    position relative
    background var(--tv-card)
    border 1px solid var(--tv-border)
    border-radius 16px
    padding .9rem .95rem .8rem
    box-shadow inset 0 1px 0 rgba(243, 248, 255, .04), 0 10px 24px -16px rgba(0, 0, 0, .6)
    overflow hidden

    // 入口提示：右下角的三角箭头避免和右上角的统计标签重叠
    &::after
      content ""
      position absolute
      right .8rem
      bottom .9rem
      width 0
      height 0
      border-top 5px solid transparent
      border-bottom 5px solid transparent
      border-left 7px solid rgba(87, 241, 237, .78)
      filter drop-shadow(0 0 5px rgba(87, 241, 237, .42))
      pointer-events none

    &:hover::after
      border-left-color var(--tv-cyan)

  .travel-fp-ic
    width 32px
    height 32px
    border-radius 10px
    display flex
    align-items center
    justify-content center
    margin-bottom .5rem

    .travel-ic
      width 17px
      height 17px

  .travel-fp-label
    font-size .78rem
    color var(--tv-muted)

  .travel-fp-value
    font-size 1.7rem
    line-height 1.2

  .travel-fp-chips
    display flex
    flex-wrap wrap
    gap .3rem
    margin-top .35rem
    min-height 20px

  .travel-fp-chip
    font-size .68rem
    padding .06rem .5rem
    border-radius 999px
    background rgba(87, 241, 237, .12)
    color var(--tv-cyan)
    border 1px solid rgba(87, 241, 237, .25)

  .travel-fp-tag
    position absolute
    top 0
    right 0
    display flex
    align-items center
    gap .3rem
    font-size .68rem
    border-radius 0 16px 0 12px
    padding .18rem .55rem
    background linear-gradient(90deg, rgba(154, 124, 255, .25), rgba(93, 141, 255, .25))
    border-left 1px solid var(--tv-border)
    border-bottom 1px solid var(--tv-border)

    em
      font-style normal
      color var(--tv-violet)
      font-weight 700

    span
      color var(--tv-text)

  // ---- 年度飞行报告（蓝紫渐变横幅） ----
  .travel-report
    padding 0
    overflow hidden

  .travel-report-link
    display block
    color inherit
    text-decoration none
    cursor pointer

    &:hover
      border-color rgba(108, 236, 255, .72)
      box-shadow 0 14px 34px rgba(13, 93, 140, .2)

  .travel-report-banner
    padding 1.1rem 1.4rem
    background linear-gradient(100deg, rgba(93, 141, 255, .35), rgba(154, 124, 255, .3) 55%, rgba(87, 241, 237, .18))
    border-bottom 1px solid var(--tv-border)
    display flex
    align-items baseline
    gap .8rem
    flex-wrap wrap

  .travel-report-banner-title
    font-size 1.15rem
    font-weight 800
    letter-spacing .04em

  .travel-report-banner-sub
    font-size .8rem
    color rgba(243, 248, 255, .75)

  .travel-report-grid
    display grid
    grid-template-columns repeat(auto-fit, minmax(150px, 1fr))
    gap .7rem
    padding 1.1rem 1.4rem 1.2rem

  .travel-report-item
    padding .75rem .85rem
    border-radius 12px
    background var(--tv-card-alt)
    border 1px solid rgba(38, 56, 77, .7)

  .travel-report-value
    font-size 1.1rem
    line-height 1.4
    word-break break-all

  .travel-report-label
    font-size .76rem
    color var(--tv-muted)

  .travel-report-cta
    display flex
    align-items center
    justify-content space-between
    padding .72rem 1.4rem
    border-top 1px solid rgba(38, 56, 77, .7)
    color var(--tv-cyan)
    font-size .82rem
    font-weight 750

  // ---- 飞行日历（青绿 5 级热力） ----
  .travel-cal-scroll
    overflow-x auto
    padding-bottom .3rem

  .travel-cal
    display flex
    gap 6px
    width 100%
    min-width 680px

  .travel-cal-weekdays
    display grid
    grid-template-rows repeat(7, 10px)
    row-gap 3px
    margin-top 18px
    font-size .68rem
    color var(--tv-muted)

    span
      line-height 10px
      height 10px

  .travel-cal-main
    flex 1
    min-width 0

  .travel-cal-year-block + .travel-cal-year-block
    margin-top 1.15rem
    padding-top 1.1rem
    border-top 1px solid rgba(38, 56, 77, .75)

  .travel-cal-year-heading
    margin 0 0 .55rem
    color var(--tv-text)
    font-size .9rem
    font-weight 700

  .travel-cal-months
    position relative
    height 16px
    margin-bottom 2px
    font-size .68rem
    color var(--tv-muted)

    span
      position absolute
      top 0

  .travel-cal-grid
    display grid
    grid-template-rows repeat(7, 10px)
    grid-auto-flow column
    gap 3px

  .travel-cal-day
    width 10px
    height 10px
    border-radius 2px
    background rgba(143, 162, 183, .12)

    &[data-level="1"]
      background rgba(81, 225, 165, .28)

    &[data-level="2"]
      background rgba(81, 225, 165, .5)

    &[data-level="3"]
      background rgba(81, 225, 165, .78)

    &[data-level="4"]
      background var(--tv-cyan)
      box-shadow 0 0 6px rgba(87, 241, 237, .5)

    &:focus-visible
      outline 2px solid var(--tv-cyan)
      outline-offset 1px

  .travel-cal-blank
    visibility hidden

  .travel-cal-legend
    display flex
    align-items center
    justify-content flex-end
    gap 3px
    margin-top .5rem
    font-size .72rem
    color var(--tv-muted)

  // ---- 年度趋势（青绿渐变折线/面积） ----
  .travel-trend-svg
    width 100%
    height auto
    display block

  .travel-trend-grid line
    stroke rgba(143, 162, 183, .18)
    stroke-width 1
    stroke-dasharray 3 5

  .travel-trend-area
    fill url(#travelTrendAreaGrad)

  .travel-trend-line
    fill none
    stroke url(#travelTrendLine)
    stroke-width 2.4
    stroke-linejoin round
    stroke-linecap round

  .travel-trend-dot
    fill var(--tv-green)
    stroke var(--tv-card)
    stroke-width 2

  .travel-trend-svg text
    fill var(--tv-text)
    font-size .75rem

  .travel-trend-val
    font-weight 700

  .travel-trend-year
    fill var(--tv-muted)

  // ---- 搭乘航司（霓虹棱镜徽章） ----
  .travel-prism-row
    display grid
    grid-template-columns repeat(4, 1fr)
    gap .8rem
    margin-bottom 1rem

    +maxWidth768()
      grid-template-columns repeat(2, 1fr)

  .travel-prism
    position relative
    text-align center
    padding 1rem .5rem .9rem
    border-radius 16px
    background var(--tv-card-alt)
    border 1px solid var(--tv-border)
    overflow hidden

  .travel-prism-num
    font-size 1.5rem

    .travel-unit
      font-size .72rem

  // 航司 logo 槽：横向字标需保留足够宽度；缺失时仍回退为方形文字徽标
  .travel-prism-logo
    position relative
    width 118px
    height 48px
    margin .55rem auto
    border-radius 12px
    display flex
    align-items center
    justify-content center
    overflow hidden

    &:has(img.is-missing)
      width 44px
      height 44px

    img
      position absolute
      inset 0
      width 100%
      height 100%
      object-fit contain
      padding 5px 7px
      background #fff

      &.is-missing
        display none

    .travel-prism-mono
      font-size .9rem
      font-weight 800
      color #04101c

  .travel-prism-name
    font-size .82rem
    color var(--tv-text)
    font-weight 600

  .pc-cyan .travel-prism-logo
