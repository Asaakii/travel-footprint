//- 行程统计页（Phase 4 高保真重制）
//- 深色科技风、原创翼形品牌位与线性图标；不含任何航旅纵横商标/素材

//- 原创线性图标（统一 1.8px 描边，装饰用途 aria-hidden）
mixin travelIcon(name)
  svg.travel-ic(viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true")
    case name
      when 'route'
        path(d="M4 18c5-1 11-6 16-12")
        circle(cx="4" cy="18" r="1.6")
        circle(cx="20" cy="6" r="1.6")
      when 'clock'
        circle(cx="12" cy="12" r="9")
        path(d="M12 7v5l3.2 2")
      when 'plane'
        path(d="M22 2L11 13")
        path(d="M22 2l-7 20-4-9-9-4 20-7z")
      when 'globe'
        circle(cx="12" cy="12" r="9")
        path(d="M3 12h18")
        path(d="M12 3c2.6 2.6 3.9 5.6 3.9 9s-1.3 6.4-3.9 9c-2.6-2.6-3.9-5.6-3.9-9s1.3-6.4 3.9-9z")
      when 'flag'
        path(d="M5 21V4")
        path(d="M5 4h11.5L14 8l2.5 4H5")
      when 'pin'
        path(d="M12 21s-6.8-5.4-6.8-10.8a6.8 6.8 0 1 1 13.6 0C18.8 15.6 12 21 12 21z")
        circle(cx="12" cy="10" r="2.4")
      when 'tower'
        path(d="M8.5 21l1.2-9h4.6l1.2 9")
        path(d="M7 12h10")
        path(d="M9.5 12V9h5v3")
        path(d="M12 9V5")
        path(d="M10 5h4")

#travel
  if site.data.travel
    - var t = site.data.travel
    - var yearKeys = Object.keys(t.years).sort().reverse()
    - var latestYear = yearKeys[0]
    //- 聚合数据内嵌给前端交互（已脱敏；转义 < 防止 </script> 截断）
    - var travelJson = JSON.stringify(t).replace(/</g, "\\u003c")
    //- 航司中文显示名（仅 UI 映射，JSON 保留原始聚合键）
    - var airlineNames = { "Air China": "中国国航", "Egyptair": "埃及航空", "Air Cairo": "开罗航空", "China Southern Airlines": "南方航空", "Shanghai Airlines": "上海航空", "China Eastern Airlines": "东方航空", "All Nippon Airways": "全日空", "Sichuan Airlines": "四川航空", "Loong Air": "长龙航空", "Malindo Air": "马印航空", "AirAsia": "亚洲航空", "Xiamen Airlines": "厦门航空", "VietJet Air": "越捷航空" }
    - var alName = function (k) { return airlineNames[k] || k }
    //- 这五家没有随项目分发的可验证本地素材，直接使用来源页公开的真实标志；其余继续使用本地 SVG。
    - var airlineLogoSources = { "China Eastern Airlines": "https://upload.wikimedia.org/wikipedia/en/6/6b/China_Eastern_Airlines_logo.svg", "Egyptair": "https://upload.wikimedia.org/wikipedia/commons/c/c2/Egyptair-Logo-2010.svg", "Loong Air": "https://upload.wikimedia.org/wikipedia/en/3/35/LoongAir_logo.png", "Shanghai Airlines": "https://upload.wikimedia.org/wikipedia/en/4/4e/Shanghai_Airlines.svg", "Xiamen Airlines": "https://www.xiamenair.com/i18n-ow-_nuxt/img/logo@3x.7a49c02.svg" }
    //- 大洲中文名
    - var contZh = { "Asia": "亚洲", "Europe": "欧洲", "Africa": "非洲", "North America": "北美洲", "South America": "南美洲", "Oceania": "大洋洲", "Antarctica": "南极洲" }
    //- 机场城市 UI 显示映射（仅展示层；JSON 保留 OpenFlights 原始字段）
    - var cityDisplay = { "TFU": "成都天府" }
    //- 仪表盘
    - var kmTotal = t.overall.distanceKm
    - var milestonePct = Math.min(Math.round(kmTotal / 100000 * 100), 100)
    - var GAUGE_C = Math.round(2 * Math.PI * 70 * 100) / 100
    - var gaugeOffset = Math.round(GAUGE_C * (1 - Math.min(kmTotal / 100000, 1)) * 100) / 100
    - var durH = Math.floor(t.overall.durationMin / 60)
    - var durM = t.overall.durationMin % 60
    - var annualReport = t.years["2025"] || t.years[latestYear]
    - var annualReportYear = t.years["2025"] ? "2025" : latestYear
    - var annualReportDurH = Math.floor(annualReport.totals.durationMin / 60)
    - var annualReportDurM = annualReport.totals.durationMin % 60
    - var annualReportTopRoute = annualReport.routes[0]
    - var annualReportAirlineList = Object.keys(annualReport.airlines).map(function (k) { return { name: alName(k), flights: annualReport.airlines[k].flights } }).sort(function (a, b) { return b.flights - a.flights })
    //- 足迹角标（去过最多 / 飞行最多）
    - var topAirport = Object.keys(t.airports).map(function (k) { return t.airports[k] }).sort(function (a, b) { return b.visits - a.visits })[0]
    - var topRoute = t.routes[0]
    //- 航司
    - var airlineList = Object.keys(t.airlines).map(function (k) { var slug = k.toLowerCase().replace(/[^a-z0-9]/g, ""); return { key: k, slug: slug, logo: airlineLogoSources[k] || "/img/travel/airlines/" + slug + ".svg", name: alName(k), flights: t.airlines[k].flights } }).sort(function (a, b) { return b.flights - a.flights })
    - var maxAirlineFlights = airlineList.length ? airlineList[0].flights : 1
    - var prismColors = ["cyan", "green", "blue", "violet"]
    //- 机型制造商徽章（固定四席，次数为真实聚合；其他 = 已识别 - 三大）
    - var mfrKnown = t.overall.aircraftKnownFlights
    - var mfrTotal = mfrKnown + t.overall.aircraftUnknownFlights
    - var mfrBig3 = [{ key: "Airbus", zh: "空客" }, { key: "Boeing", zh: "波音" }, { key: "COMAC", zh: "中国商飞" }]
    - var mfrBig3Sum = mfrBig3.reduce(function (s, m) { return s + (t.manufacturers[m.key] ? t.manufacturers[m.key].flights : 0) }, 0)
    - var mfrOtherCount = mfrKnown - mfrBig3Sum
    - var modelList = Object.keys(t.aircraft).map(function (k) { return { model: k, mfr: t.aircraft[k].manufacturer, flights: t.aircraft[k].flights } }).sort(function (a, b) { return b.flights - a.flights })
    //- 飞行日历（SSR 先渲染最近一年，前端加载后在「全部」模式展示所有年份）
    - var calCounts = t.years[latestYear].dailyCounts
    - var calYearNum = parseInt(latestYear, 10)
    - var calLeap = (calYearNum % 4 === 0 && calYearNum % 100 !== 0) || calYearNum % 400 === 0
    - var calOffset = (new Date(Date.UTC(calYearNum, 0, 1)).getUTCDay() + 6) % 7
    - var calDays = calLeap ? 366 : 365
    - var calMonthDays = [31, calLeap ? 29 : 28, 31, 30, 31, 30, 31, 31, 30, 31, 30, 31]
    - var calCells = []
    - for (var ci = 0; ci < calOffset; ci++) calCells.push(null)
    - for (var cd = 1; cd <= calDays; cd++) { var cdt = new Date(Date.UTC(calYearNum, 0, cd)); var cmm = ("0" + (cdt.getUTCMonth() + 1)).slice(-2); var cdd = ("0" + cdt.getUTCDate()).slice(-2); var ccnt = calCounts[cmm + "-" + cdd] || 0; calCells.push({ label: (cdt.getUTCMonth() + 1) + "月" + cdt.getUTCDate() + "日", count: ccnt, level: ccnt === 0 ? 0 : ccnt === 1 ? 1 : ccnt === 2 ? 2 : ccnt === 3 ? 3 : 4 }) }
    - var calWeeks = Math.ceil(calCells.length / 7)
    - var calMonths = []
    - var calDoy = 1
    - for (var cm = 0; cm < 12; cm++) { calMonths.push({ name: (cm + 1) + "月", col: Math.floor((calDoy - 1 + calOffset) / 7) }); calDoy += calMonthDays[cm] }
    //- 年度趋势（SSR 静态：青绿渐变折线/面积 + 竖向虚线 + 节点数值）
    - var trendYears = Object.keys(t.years).sort()
    - var trendMax = Math.max.apply(null, trendYears.map(function (y) { return t.years[y].totals.flights }).concat([1]))
    - var TW = 640, TH = 220, TPX = 40, TPT = 26, TPB = 30
    - var trendPts = trendYears.map(function (y, i) { var x = trendYears.length === 1 ? TW / 2 : TPX + i * (TW - 2 * TPX) / (trendYears.length - 1); var yv = TPT + (1 - t.years[y].totals.flights / trendMax) * (TH - TPT - TPB); return { x: Math.round(x * 10) / 10, y: Math.round(yv * 10) / 10, year: y, v: t.years[y].totals.flights } })
    - var trendLinePts = trendPts.map(function (p) { return p.x + "," + p.y }).join(" ")
    - var trendAreaD = "M " + trendPts[0].x + " " + (TH - TPB) + " L " + trendPts.map(function (p) { return p.x + " " + p.y }).join(" L ") + " L " + trendPts[trendPts.length - 1].x + " " + (TH - TPB) + " Z"
    //- 航线图（SSR 全量默认态：逐航段扇形错开，不合并）
    - var mapLegs = (t.mapLegs && t.mapLegs.length) ? t.mapLegs : t.routes
    //- 用户在 OpenFlights 导出中标记的航段用紫色；其余航段统一青色
    - var purpleLegs = { "CAI-PEK": 1, "CAI-ASW": 1, "IST-CAI": 1, "PKX-IST": 1, "NRT-PVG": 1, "OKA-HND": 1, "ITM-OKA": 1, "PVG-KIX": 1, "NRT-DLC": 1, "CTS-HND": 1, "HKD-CTS": 1, "HND-CTS": 1, "DLC-NRT": 1 }
    - var isPurpleLeg = function (rt) { return !!purpleLegs[rt.from + "-" + rt.to] }
    - var legColor = function (rt) { return isPurpleLeg(rt) ? "lc2" : "lc0" }
    - var legStroke = function (rt) { return isPurpleLeg(rt) ? "#9a7cff" : "#57f1ed" }
    - var apCount = {}
    - t.routes.forEach(function (rt) { apCount[rt.from] = (apCount[rt.from] || 0) + rt.flights; apCount[rt.to] = (apCount[rt.to] || 0) + rt.flights; })
    - var mapProject = function (lon, lat) { return { x: (lon + 180) / 360 * 1000, y: (90 - lat) / 180 * 500 } }
    //- 所有机场均展示 IATA；高频机场优先占位，邻近机场自动换到其他方位
    - var mapAirportLabelPositions = function (counts) { var placed = [], positions = {}, candidates = [], intersects = function (a, b) { return a.x < b.x + b.w + 2 && a.x + a.w + 2 > b.x && a.y < b.y + b.h + 2 && a.y + a.h + 2 > b.y; }, nodeBoxes = Object.keys(counts).map(function (iata) { var p = mapProject(t.airports[iata].lon, t.airports[iata].lat); return { x: p.x - 7, y: p.y - 7, w: 14, h: 14 }; }); [10, 24, 40, 56, 72, 88].forEach(function (radius) { for (var step = 0; step < 8; step++) { var angle = step * Math.PI / 4, dx = Math.round(Math.cos(angle) * radius); candidates.push({ dx: dx, dy: Math.round(Math.sin(angle) * radius) + 4, anchor: dx >= 0 ? "start" : "end" }); } }); Object.keys(counts).sort(function (a, b) { return counts[b] - counts[a] || a.localeCompare(b); }).forEach(function (iata) { var ap = t.airports[iata], p = mapProject(ap.lon, ap.lat), width = iata.length * 7.5 + 3, selected; candidates.some(function (c) { var x = Math.min(Math.max(p.x + c.dx, c.anchor === "start" ? 4 : width + 4), c.anchor === "start" ? 996 - width : 996), y = Math.min(Math.max(p.y + c.dy, 12), 494), box = { x: c.anchor === "start" ? x : x - width, y: y - 11, w: width, h: 14 }; if (placed.some(function (other) { return intersects(box, other); }) || nodeBoxes.some(function (node) { return intersects(box, node); })) return false; selected = { x: x, y: y, anchor: c.anchor, box: box }; return true; }); if (!selected) { var fallback = candidates[candidates.length - 1], fx = Math.min(Math.max(p.x + fallback.dx, 4), 996 - width), fy = Math.min(Math.max(p.y + fallback.dy, 12), 494); selected = { x: fx, y: fy, anchor: fallback.anchor, box: { x: fx, y: fy - 11, w: width, h: 14 } }; } placed.push(selected.box); positions[iata] = selected; }); return positions; }
    - var mapAirportLabels = mapAirportLabelPositions(apCount)
    - var contDeco = [{ n: "北美洲", lon: -102, lat: 47 }, { n: "南美洲", lon: -60, lat: -14 }, { n: "欧洲", lon: 16, lat: 54 }, { n: "非洲", lon: 20, lat: 8 }, { n: "亚洲", lon: 88, lat: 46 }, { n: "大洋洲", lon: 134, lat: -26 }]
    script#travel-data(type="application/json")!= travelJson

    //- ===== 标题栏：原创翼形航迹标识 + 行程统计 =====
    header.travel-top
      .travel-brand
        svg.travel-brand-mark(viewBox="0 0 48 48" aria-hidden="true")
          defs
            linearGradient#travelWingGrad(x1="0" y1="1" x2="1" y2="0")
              stop(offset="0" stop-color="#57f1ed")
              stop(offset="1" stop-color="#9a7cff")
          path(d="M5 35c11-2 22-10 32-23 2-2.4 5-3.4 6.2-2.2 1.2 1.2.2 4-2.2 6C30.5 27 19.5 34 9 37.5c-3.2 1-5.3-1.2-4-2.5z" fill="url(#travelWingGrad)")
          path(d="M8 40.5c9 0 18.5-2.4 27-6.5" stroke="#57f1ed" stroke-width="1.6" fill="none" stroke-linecap="round" opacity=".65")
        .travel-brand-text
          .travel-brand-title 行程统计
          .travel-brand-sub 我的飞行足迹

    //- ===== 年份胶囊 =====
    .travel-year-filter(role="group" aria-label="按年份筛选")
      button.travel-year-chip.active(type="button" data-year="all" aria-pressed="true") 全部
      each y in yearKeys
        button.travel-year-chip(type="button" data-year=y aria-pressed="false")= y

    //- ===== 航线图 =====
    section.travel-card.travel-map
      .travel-section-head
        span.travel-section-title
          +travelIcon('globe')
          | 航线图
        span.travel-period-label(data-field="mapMeta")= "全部 · " + mapLegs.length + " 条航迹 · " + t.footprint.airports + " 座机场"
      .travel-map-wrap
        svg.travel-map-svg(viewBox="0 0 1000 500" preserveAspectRatio="xMidYMid slice" data-zoom="far" role="img" draggable="false" aria-label="世界航线图：" + mapLegs.length + " 条航迹，" + t.footprint.airports + " 座机场。支持拖动与滚轮缩放")
          defs
            radialGradient#travelMapGlow(cx="58%" cy="42%" r="55%")
              stop(offset="0" stop-color="#57f1ed" stop-opacity=".14")
              stop(offset=".55" stop-color="#1b4a66" stop-opacity=".08")
              stop(offset="1" stop-color="#04101c" stop-opacity="0")
          rect.travel-map-ocean(x="0" y="0" width="1000" height="500")
          g.travel-map-grid(aria-hidden="true")
            - for (var glon = -160; glon <= 160; glon += 20)
              - var gx = mapProject(glon, 0).x.toFixed(1)
              line(x1=gx y1="0" x2=gx y2="500")
            - for (var glat = -60; glat <= 80; glat += 20)
              - var gy = mapProject(0, glat).y.toFixed(1)
              line(x1="0" y1=gy x2="1000" y2=gy)
          rect.travel-map-glow(x="0" y="0" width="1000" height="500" fill="url(#travelMapGlow)")
          g.travel-map-contlabels(aria-hidden="true")
            each cl in contDeco
              - var cp = mapProject(cl.lon, cl.lat)
              text(x=cp.x.toFixed(1) y=cp.y.toFixed(1))= cl.n
          g.travel-map-land(aria-hidden="true")
            include ./travel-land.svg
          g.travel-map-land-detail(aria-hidden="true")
            include ./travel-land-detail.svg
          g.travel-map-borders(aria-hidden="true")
            include ./travel-borders.svg
          g.travel-map-borders-detail(aria-hidden="true")
            include ./travel-borders-detail.svg
          g.travel-map-provinces(aria-hidden="true")
            include ./travel-provinces.svg
          if site.data.travel_map_labels
            g.travel-map-layer-countries(aria-hidden="true")
              each c in site.data.travel_map_labels.countries
                text(x=c.x y=c.y)= c.n
            g.travel-map-layer-capitals(aria-hidden="true")
              each c in site.data.travel_map_labels.capitals
                - var capX = Math.min(c.x, 998)
                circle(cx=capX cy=c.y r="1.1")
                text(x=(capX + 2.4).toFixed(1) y=c.y)= c.n
            g.travel-map-layer-provinces(aria-hidden="true")
              each p in site.data.travel_map_labels.provinces
                text(x=p.x y=p.y)= p.n
          g.travel-map-routes(data-field="mapRoutes")
            each rt in mapLegs
              - var rlabel = rt.from + " → " + rt.to
              path(class=legColor(rt) d=rt.d style="stroke:" + legStroke(rt) + ";stroke-width:1.75;opacity:0.82" tabindex="0" role="img" aria-label=rlabel)
                title= rlabel
          g.travel-map-arrows(data-field="mapArrows" aria-hidden="true")
            each rt in mapLegs
              each arw in rt.arrows
                path(class=legColor(rt) d="M -3.6 -2.6 L 4 0 L -3.6 2.6 Z" style="fill:" + legStroke(rt) + ";stroke:none" transform=`translate(${arw.x} ${arw.y}) rotate(${arw.deg})`)
          g.travel-map-airports(data-field="mapAirports")
            each iata in Object.keys(apCount)
              - var ap = t.airports[iata]
              - var pp = mapProject(ap.lon, ap.lat)
              - var ar = Math.min(2 + Math.sqrt(apCount[iata]) * 1.2, 6)
              circle.travel-map-halo(cx=pp.x.toFixed(1) cy=pp.y.toFixed(1) r=(ar * 2.2).toFixed(1) style=`--r:${(ar * 2.2).toFixed(1)}px`)
              circle.travel-map-node(cx=pp.x.toFixed(1) cy=pp.y.toFixed(1) r=ar.toFixed(1) style=`--r:${ar.toFixed(1)}px`)
                title= iata + " · " + ap.city + "，" + apCount[iata] + " 航段"
            each iata in Object.keys(apCount)
              - var labelPos = mapAirportLabels[iata]
              text.travel-map-aplabel(x=labelPos.x.toFixed(1) y=labelPos.y.toFixed(1) text-anchor=labelPos.anchor)= iata
      .travel-map-legend(aria-hidden="true")
        span.travel-map-legend-item
          i.travel-map-legend-dot
          | 机场（大小 = 航段数）

    //- ===== 总览仪表盘 =====
    section.travel-card.travel-dash
      .travel-dash-gauge
        svg(viewBox="0 0 180 180" role="img" aria-label="十万公里里程碑进度 " + milestonePct + "%")
          defs
            linearGradient#travelGaugeGrad(x1="0" y1="1" x2="1" y2="0")
              stop(offset="0" stop-color="#57f1ed")
              stop(offset=".55" stop-color="#51e1a5")
              stop(offset="1" stop-color="#5d8dff")
          circle.travel-gauge-track(cx="90" cy="90" r="70")
          circle.travel-gauge-val(data-field="gaugeArc" cx="90" cy="90" r="70" transform="rotate(-90 90 90)" stroke-dasharray=GAUGE_C stroke-dashoffset=gaugeOffset)
        .travel-gauge-center
          .travel-gauge-num(data-field="gaugeKm")= kmTotal.toLocaleString("en-US")
          .travel-gauge-unit km
        .travel-gauge-caption(data-field="gaugePct")= "十万公里里程碑 " + milestonePct + "%"
      .travel-dash-stats
        .travel-dash-stat
          .travel-dash-ic.ic-cyan
            +travelIcon('route')
          .travel-dash-stat-text
            .travel-dash-label 飞行里程
            .travel-dash-value
              span.travel-num(data-field="rDistance")= kmTotal.toLocaleString("en-US")
              span.travel-unit km
        .travel-dash-stat
          .travel-dash-ic.ic-green
            +travelIcon('clock')
          .travel-dash-stat-text
            .travel-dash-label 飞行时长
            .travel-dash-value
              span.travel-num(data-field="rDurationH")= durH
              span.travel-unit h
              span.travel-num.travel-num-sm(data-field="rDurationM")= durM
              span.travel-unit min
        .travel-dash-stat
          .travel-dash-ic.ic-violet
            +travelIcon('plane')
          .travel-dash-stat-text
            .travel-dash-label 飞行次数
            .travel-dash-value
              span.travel-num(data-field="rFlights")= t.overall.flights
              span.travel-unit 次

    //- ===== 五项足迹（点击进入二级明细页） =====
    section.travel-footprint
      a.travel-fp-card(href="/travel/continents/" aria-label="查看大洲明细")
        .travel-fp-ic.ic-cyan
          +travelIcon('globe')
        .travel-fp-label 大洲
        .travel-fp-value.travel-num(data-field="continents")= t.footprint.continents
        .travel-fp-chips(data-field="continentChips")
          each c in t.footprint.continentList
            span.travel-fp-chip= contZh[c] || c
      a.travel-fp-card(href="/travel/countries/" aria-label="查看国家与地区明细")
        .travel-fp-ic.ic-green
          +travelIcon('flag')
        .travel-fp-label 国家/地区
        .travel-fp-value.travel-num(data-field="countries")= t.footprint.countries
      a.travel-fp-card(href="/travel/cities/" aria-label="查看城市明细")
        .travel-fp-ic.ic-blue
          +travelIcon('pin')
        .travel-fp-label 城市
        .travel-fp-value.travel-num(data-field="cities")= t.footprint.cities
      a.travel-fp-card(href="/travel/airports/" aria-label="查看机场明细")
        .travel-fp-ic.ic-violet
          +travelIcon('tower')
        .travel-fp-label 机场
        .travel-fp-value.travel-num(data-field="airports")= t.footprint.airports
        .travel-fp-tag
          em 去过最多
          span(data-field="tagTopAirport")= topAirport ? (cityDisplay[topAirport.iata] || topAirport.city) : "—"
      a.travel-fp-card(href="/travel/routes/" aria-label="查看航线明细")
        .travel-fp-ic.ic-cyan
          +travelIcon('route')
        .travel-fp-label 去重航线
        .travel-fp-value.travel-num(data-field="routes")= t.footprint.routes
        .travel-fp-tag
          em 飞行最多
          span(data-field="tagTopRoute")= topRoute ? topRoute.from + "-" + topRoute.to : "—"

    //- ===== 年度飞行报告 =====
    a.travel-card.travel-report.travel-report-link(href=`/travel/report/${annualReportYear}/` aria-label=`打开 ${annualReportYear} 年度飞行报告`)
      .travel-report-banner
        span.travel-report-banner-title= annualReportYear + " 年度飞行报告"
        span.travel-report-banner-sub= "打开沉浸式年度回顾"
      .travel-report-grid
        .travel-report-item
          .travel-report-value.travel-num= annualReport.totals.distanceKm.toLocaleString("en-US") + " km"
          .travel-report-label 飞行里程
        .travel-report-item
          .travel-report-value.travel-num= annualReportDurH + "h " + annualReportDurM + "min"
          .travel-report-label 飞行时长
        .travel-report-item
          .travel-report-value.travel-num= annualReport.totals.flights + " 次"
          .travel-report-label 飞行次数
        .travel-report-item
          .travel-report-value.travel-num= annualReportTopRoute ? annualReportTopRoute.from + " ⇋ " + annualReportTopRoute.to + " × " + annualReportTopRoute.flights : "—"
          .travel-report-label 最常飞航线
        .travel-report-item
          .travel-report-value.travel-num= annualReportAirlineList.length ? annualReportAirlineList[0].name + " × " + annualReportAirlineList[0].flights : "—"
          .travel-report-label 最常搭乘航司
      .travel-report-cta
        span 查看年度故事
        span(aria-hidden="true") →

    //- ===== 飞行日历（年热力 / 月分布 / 日明细 三视图） =====
    section.travel-card.travel-calendar
      .travel-section-head
        span.travel-section-title 飞行日历
        .travel-cal-head-controls
          label.travel-cal-year-label
            span.travel-cal-year-label-text 选择日历年份
            select.travel-cal-year-select(data-field="calYearSelect" aria-label="选择日历年份")
              option(value=latestYear selected)= latestYear + " 年"
              each yy in yearKeys
                if yy !== latestYear
                  option(value=yy)= yy + " 年"
              option(value="all") 全部年份
      .travel-cal-switch(role="group" aria-label="日历视图切换")
        button.travel-cal-view-btn.active(type="button" data-view="year" aria-pressed="true") 年
        button.travel-cal-view-btn(type="button" data-view="month" aria-pressed="false") 月
        button.travel-cal-view-btn(type="button" data-view="day" aria-pressed="false") 日
      .travel-cal-viewyear(data-field="calViewYear")
        .travel-cal-scroll
          .travel-cal
            .travel-cal-weekdays(aria-hidden="true")
              span(style="grid-row: 1") 一
              span(style="grid-row: 4") 四
            .travel-cal-main(data-field="calMain")
              .travel-cal-months(data-field="calMonths" aria-hidden="true")
                each mo in calMonths
                  span(style=`left:${(mo.col * 13 / (calWeeks * 13 - 3) * 100).toFixed(2)}%`)= mo.name
              .travel-cal-grid(data-field="calGrid" role="list" aria-label="全年逐日飞行热力图" style=`grid-template-columns: repeat(${calWeeks}, minmax(10px, 1fr))`)
                each cell in calCells
                  if cell
                    span.travel-cal-day(role="listitem" data-level=cell.level tabindex=cell.count > 0 ? "0" : "-1" title=`${cell.label}：${cell.count} 次飞行` aria-label=`${cell.label}：${cell.count} 次飞行`)
                  else
                    span.travel-cal-day.travel-cal-blank(aria-hidden="true")
        .travel-cal-legend(aria-hidden="true")
          span 少
          each lv in [0, 1, 2, 3, 4]
            span.travel-cal-day(data-level=lv)
          span 多
      .travel-cal-viewmonth(data-field="calViewMonth" hidden)
      .travel-cal-viewday(data-field="calViewDay" hidden)

    //- ===== 年度趋势 =====
    section.travel-card.travel-trend
      .travel-section-head
        span.travel-section-title 年度趋势
        span.travel-period-label 飞行次数（次）
      svg.travel-trend-svg(viewBox=`0 0 ${TW} ${TH}` role="img" aria-label="各年份飞行次数趋势图")
        defs
          linearGradient#travelTrendLine(x1="0" y1="0" x2="1" y2="0")
            stop(offset="0" stop-color="#51e1a5")
            stop(offset="1" stop-color="#57f1ed")
          linearGradient#travelTrendAreaGrad(x1="0" y1="0" x2="0" y2="1")
            stop(offset="0" stop-color="#51e1a5" stop-opacity=".32")
            stop(offset="1" stop-color="#51e1a5" stop-opacity="0")
        g.travel-trend-grid(aria-hidden="true")
          each p in trendPts
            line(x1=p.x y1=TPT - 6 x2=p.x y2=TH - TPB)
        path.travel-trend-area(d=trendAreaD)
        polyline.travel-trend-line(points=trendLinePts)
        each p in trendPts
          circle.travel-trend-dot(cx=p.x cy=p.y r="4")
            title= p.year + " 年：" + p.v + " 次"
          text.travel-trend-val(x=p.x y=p.y - 10 text-anchor="middle")= p.v
          text.travel-trend-year(x=p.x y=TH - 8 text-anchor="middle")= p.year

    //- ===== 搭乘航司 =====
    section.travel-card.travel-airlines
      .travel-section-head
        span.travel-section-title 搭乘航司
        span.travel-period-label(data-field="airlineCount")= "共搭乘 " + airlineList.length + " 家"
      .travel-prism-row(data-field="prismRow")
        each a, i in airlineList.slice(0, 4)
          .travel-prism(class="pc-" + prismColors[i])
            .travel-prism-num.travel-num= a.flights
              span.travel-unit 次
            .travel-prism-logo(aria-hidden="true")
              img(src=a.logo alt="" onerror="this.classList.add('is-missing')")
              span.travel-prism-mono= a.name.slice(0, 2)
            .travel-prism-name= a.name
      .travel-bar-list(data-field="airlineList")
        each a, i in airlineList
          - var share = (a.flights / t.overall.flights * 100).toFixed(1)
          .travel-bar-row(class=i >= 8 ? "travel-extra" : "")
            .travel-bar-head
              span.travel-bar-name= a.name
              span.travel-bar-meta= a.flights + " 次 · " + share + "%"
            .travel-bar-track
              .travel-bar-fill(style=`width:${(a.flights / maxAirlineFlights * 100).toFixed(1)}%`)
      button.travel-toggle(type="button" data-field="airlineToggle" aria-expanded="false") 展开全部

    //- ===== 乘坐机型 =====
    section.travel-card.travel-fleet
      .travel-section-head
        span.travel-section-title 乘坐机型
        span.travel-completeness(data-field="fleetCompleteness")= "已识别 " + mfrKnown + "/" + mfrTotal + " 航段"
      .travel-mfr-row(data-field="mfrRow")
        each m, i in mfrBig3
          - var mflights = t.manufacturers[m.key] ? t.manufacturers[m.key].flights : 0
          .travel-mfr-badge(class="pc-" + prismColors[i])
            .travel-mfr-orb(aria-hidden="true")
              img(src=`/img/travel/manufacturers/${m.key.toLowerCase()}.svg` alt="" onerror="this.classList.add('is-missing')")
              span= m.key
            .travel-mfr-name= m.zh
            .travel-mfr-count.travel-num= mflights
              span.travel-unit 次
        .travel-mfr-badge.pc-green
          .travel-mfr-orb(aria-hidden="true")
            span ···
          .travel-mfr-name 其他
          .travel-mfr-count.travel-num= mfrOtherCount
            span.travel-unit 次
      .travel-sub-title 机型排行
      .travel-model-list(data-field="modelList")
        each m, i in modelList
          .travel-model-row(class=i >= 8 ? "travel-extra" : "")
            span.travel-model-rank= i + 1
            span.travel-model-name= m.model
            span.travel-model-mfr= m.mfr
            span.travel-model-flights.travel-num= m.flights
              span.travel-unit 次
      button.travel-toggle(type="button" data-field="modelToggle" aria-expanded="false") 展开全部
      if mfrTotal > mfrKnown
        .travel-fleet-note(data-field="fleetNote")= "其余 " + t.overall.aircraftUnknownFlights + " 航段源数据缺少机型信息，未计入以上统计。"
      else
        .travel-fleet-note(data-field="fleetNote" style="display:none")
  else
    .travel-card.travel-empty 数据尚未生成，请先运行 npm run travel:import -- <csv路径>
  script(defer data-pjax src=url_for("/js/travel.js") + "?v=cv4")
